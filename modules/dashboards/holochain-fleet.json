{
  "uid": "holochain-fleet",
  "title": "Holochain Fleet",
  "description": "Every node the monitor scrapes: whether it and its services are up, how the machine is doing, and what its Holochain conductor is doing.",
  "tags": ["holochain", "nixos-holochain"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 3,
  "editable": true,
  "refresh": "10s",
  "time": {"from": "now-15m", "to": "now"},
  "templating": {
    "list": [
      {
        "name": "instance",
        "label": "Instance",
        "description": "The scrape targets of the holochain-nodes job. All includes nodes that appear after the page was loaded.",
        "type": "query",
        "datasource": {"type": "prometheus", "uid": "holochain-prometheus"},
        "definition": "label_values(up{job=\"holochain-nodes\"}, instance)",
        "query": {
          "query": "label_values(up{job=\"holochain-nodes\"}, instance)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {"selected": true, "text": ["All"], "value": ["$__all"]},
        "options": [],
        "regex": "",
        "hide": 0
      },
      {
        "name": "units",
        "label": "Units (regex)",
        "description": "systemd units the Services panel shows, as one regular expression Prometheus matches against the whole unit name. The default comes from services.holochain-grafana.overviewUnits; a regex typed here lives in the page URL and is never saved to the dashboard.",
        "type": "textbox",
        "query": "holochain-conductor.service|holochain-happ-installer.service|holochain-conductor-metrics.timer|holochain-http-gateway.service|(podman|docker)-wind-tunnel-runner.service|prometheus.service|prometheus-node-exporter.service|grafana.service|sshd.service|tailscaled.service|nix-daemon.socket",
        "current": {
          "text": "holochain-conductor.service|holochain-happ-installer.service|holochain-conductor-metrics.timer|holochain-http-gateway.service|(podman|docker)-wind-tunnel-runner.service|prometheus.service|prometheus-node-exporter.service|grafana.service|sshd.service|tailscaled.service|nix-daemon.socket",
          "value": "holochain-conductor.service|holochain-happ-installer.service|holochain-conductor-metrics.timer|holochain-http-gateway.service|(podman|docker)-wind-tunnel-runner.service|prometheus.service|prometheus-node-exporter.service|grafana.service|sshd.service|tailscaled.service|nix-daemon.socket"
        },
        "options": [],
        "hide": 0
      }
    ]
  },
  "annotations": {"list": []},
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Overview",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0},
      "collapsed": false,
      "panels": []
    },
    {
      "id": 2,
      "type": "table",
      "title": "Fleet status",
      "description": "One row per node, and every cell that is not plain text turns orange or red when something needs looking at. Node is Prometheus's own up series for the scrape target. Conductor is holochain_conductor_up, read together with how fresh it is: stale means the metrics timer has not written for over 120 s, so the last value it wrote no longer says anything; textfile error means node_exporter rejected a file in its textfile directory and the holochain_* series are gone; unknown means the node itself is not answering. A blank Conductor cell is a node that does not export conductor metrics at all. Apps are the installed hApps by status; Apps not enabled turns red on any app that is installed but not running. Failed units counts every systemd unit in the failed state, not only the ones listed under Services (device, scope and slice units excepted). Disk is the fullest filesystem, Memory the share of RAM in use, Temp the hottest hardware sensor (blank on a machine without sensors, such as a VM). Uptime turns orange for the first hour after a boot, so an unplanned reboot shows. Metrics age is how long ago the conductor metrics timer last wrote its textfile; its 120 s and 300 s thresholds assume conductorMetrics.interval at its 30 s default, and an interval above about 90 s needs them raised. A node that does not answer the scrape keeps its row with Node down.",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 1},
      "datasource": {"type": "prometheus", "uid": "holochain-prometheus"},
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": "holochain-prometheus"},
          "expr": "max by (instance) (up{job=\"holochain-nodes\", instance=~\"$instance\"})",
          "format": "table",
          "instant": true,
          "range": false
        },
        {
          "refId": "B",
          "datasource": {"type": "prometheus", "uid": "holochain-prometheus"},
          "expr": "max by (instance) (time() - node_boot_time_seconds{instance=~\"$instance\"})",
          "format": "table",
          "instant": true,
          "range": false
        },
        {
          "refId": "C",
          "datasource": {"type": "prometheus", "uid": "holochain-prometheus"},
          "expr": "(max by (instance) (holochain_conductor_up{instance=~\"$instance\"}) + on (instance) (2 * (max by (instance) (time() - holochain_conductor_metrics_scrape_timestamp_seconds{instance=~\"$instance\"}) > bool 120))) or on (instance) (4 * (max by (instance) (node_textfile_scrape_error{instance=~\"$instance\"}) > 0)) or on (instance) (5 + 0 * max by (instance) (up{job=\"holochain-nodes\", instance=~\"$instance\"} == 0))",
          "format": "table",
          "instant": true,
          "range": false
        },
        {
          "refId": "D",
          "datasource": {"type": "prometheus", "uid": "holochain-prometheus"},
          "expr": "sum by (instance) (node_systemd_unit_state{instance=~\"$instance\", state=\"failed\"})",
          "format": "table",
          "instant": true,
          "range": false
        },
        {
          "refId": "E",
          "datasource": {"type": "prometheus", "uid": "holochain-prometheus"},
          "expr": "max by (instance) (time() - holochain_conductor_metrics_scrape_timestamp_seconds{instance=~\"$instance\"})",
          "format": "table",
          "instant": true,
          "range": false
        },
        {
          "refId": "F",
          "datasource": {"type": "prometheus", "uid": "holochain-prometheus"},
          "expr": "max by (instance) (100 * (1 - node_filesystem_avail_bytes{instance=~\"$instance\", fstype!~\"tmpfs|ramfs|overlay|squashfs\", mountpoint!=\"/nix/store\"} / node_filesystem_size_bytes{instance=~\"$instance\", fstype!~\"tmpfs|ramfs|overlay|squashfs\", mountpoint!=\"/nix/store\"}))",
          "format": "table",
          "instant": true,
          "range": false
        },
        {
          "refId": "G",
          "datasource": {"type": "prometheus", "uid": "holochain-prometheus"},
          "expr": "max by (instance) (100 * (1 - node_memory_MemAvailable_bytes{instance=~\"$instance\"} / node_memory_MemTotal_bytes{instance=~\"$instance\"}))",
          "format": "table",
          "instant": true,
          "range": false
        },
        {
          "refId": "H",
          "datasource": {"type": "prometheus", "uid": "holochain-prometheus"},
          "expr": "max by (instance) (node_hwmon_temp_celsius{instance=~\"$instance\"})",
          "format": "table",
          "instant": true,
          "range": false
        },
        {
          "refId": "I",
          "datasource": {"type": "prometheus", "uid": "holochain-prometheus"},
          "expr": "sum by (instance) (holochain_conductor_apps{instance=~\"$instance\", status=\"enabled\"})",
          "format": "table",
          "instant": true,
          "range": false
        },
        {
          "refId": "J",
          "datasource": {"type": "prometheus", "uid": "holochain-prometheus"},
          "expr": "sum by (instance) (holochain_conductor_apps{instance=~\"$instance\", status!=\"enabled\"})",
          "format": "table",
          "instant": true,
          "range": false
        }
      ],
      "transformations": [
        {"id": "merge", "options": {}},
        {
          "id": "organize",
          "options": {
            "excludeByName": {"Time": true},
            "indexByName": {
              "instance": 0,
              "Value #A": 1,
              "Value #C": 2,
              "Value #I": 3,
              "Value #J": 4,
              "Value #D": 5,
              "Value #F": 6,
              "Value #G": 7,
              "Value #H": 8,
              "Value #B": 9,
              "Value #E": 10
            },
            "renameByName": {
              "instance": "Instance",
              "Value #A": "Node",
              "Value #C": "Conductor",
              "Value #I": "Apps enabled",
              "Value #J": "Apps not enabled",
              "Value #D": "Failed units",
              "Value #F": "Disk",
              "Value #G": "Memory",
              "Value #H": "Temp",
              "Value #B": "Uptime",
              "Value #E": "Metrics age"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {"align": "auto", "minWidth": 60, "wrapHeaderText": true, "cellOptions": {"type": "auto"}},
          "thresholds": {"mode": "absolute", "steps": [{"color": "text", "value": null}]}
        },
        "overrides": [
          {"matcher": {"id": "byName", "options": "Instance"}, "properties": [{"id": "custom.width", "value": 260}]},
          {
            "matcher": {"id": "byName", "options": "Node"},
            "properties": [
              {"id": "custom.cellOptions", "value": {"type": "color-background", "mode": "basic"}},
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {"text": "down", "color": "red", "index": 0},
                      "1": {"text": "up", "color": "green", "index": 1}
                    }
                  },
                  {
                    "type": "special",
                    "options": {"match": "null", "result": {"text": "", "color": "transparent", "index": 9}}
                  }
                ]
              }
            ]
          },
          {
            "matcher": {"id": "byName", "options": "Conductor"},
            "properties": [
              {"id": "custom.cellOptions", "value": {"type": "color-background", "mode": "basic"}},
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {"text": "down", "color": "red", "index": 0},
                      "1": {"text": "up", "color": "green", "index": 1},
                      "2": {"text": "stale, was down", "color": "orange", "index": 2},
                      "3": {"text": "stale, was up", "color": "orange", "index": 3},
                      "4": {"text": "textfile error", "color": "red", "index": 4},
                      "5": {"text": "unknown", "color": "text", "index": 5}
                    }
                  },
                  {
                    "type": "special",
                    "options": {"match": "null", "result": {"text": "", "color": "transparent", "index": 9}}
                  }
                ]
              }
            ]
          },
          {
            "matcher": {"id": "byName", "options": "Apps enabled"},
            "properties": [
              {"id": "decimals", "value": 0},
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "special",
                    "options": {"match": "null", "result": {"text": "", "color": "transparent", "index": 9}}
                  }
                ]
              }
            ]
          },
          {
            "matcher": {"id": "byName", "options": "Apps not enabled"},
            "properties": [
              {"id": "custom.cellOptions", "value": {"type": "color-background", "mode": "basic"}},
              {"id": "decimals", "value": 0},
              {
                "id": "thresholds",
                "value": {"mode": "absolute", "steps": [{"color": "transparent", "value": null}, {"color": "red", "value": 1}]}
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "special",
                    "options": {"match": "null", "result": {"text": "", "color": "transparent", "index": 9}}
                  }
                ]
              }
            ]
          },
          {
            "matcher": {"id": "byName", "options": "Failed units"},
            "properties": [
              {"id": "custom.cellOptions", "value": {"type": "color-background", "mode": "basic"}},
              {"id": "decimals", "value": 0},
              {
                "id": "thresholds",
                "value": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "special",
                    "options": {"match": "null", "result": {"text": "", "color": "transparent", "index": 9}}
                  }
                ]
              }
            ]
          },
          {
