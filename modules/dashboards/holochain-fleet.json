        "wideLayout": true,
        "showPercentChange": false
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Parts lost contact",
      "description": "How many app parts lost the others they had, or are cut off from a network the rest of the fleet is in.",
      "datasource": {
        "type": "prometheus",
        "uid": "holochain-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "holochain-prometheus"
          },
          "expr": "count(holochain:dht_state == 2) or vector(0)",
          "legendFormat": "Parts lost contact",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "decimals": 0,
          "unit": "none"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "value",
        "wideLayout": true,
        "showPercentChange": false
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Parts catching up",
      "description": "How many connected app parts hold under 95% of what their best peer holds, averaged over 10 minutes.",
      "datasource": {
        "type": "prometheus",
        "uid": "holochain-prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "holochain-prometheus"
          },
          "expr": "count(holochain:dht_state == 4) or vector(0)",
          "legendFormat": "Parts catching up",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "#EAB839",
                "value": 1
              }
            ]
          },
          "decimals": 0,
          "unit": "none"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "value",
        "wideLayout": true,
        "showPercentChange": false
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Machine problems",
      "description": "How many problems on the machines need a human; the table below says which, in words.",
      "datasource": {
        "type": "prometheus",
        "uid": "holochain-prometheus"
      },
      "gridPos": {
        "x": 20,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "holochain-prometheus"
          },
          "expr": "count(holochain:node_problem) or vector(0)",
          "legendFormat": "Machine problems",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "decimals": 0,
          "unit": "none"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "value",
        "wideLayout": true,
        "showPercentChange": false
      }
    },
    {
      "id": 7,
      "type": "table",
      "title": "Which node needs attention?",
      "description": "One row per machine, worst first: its state, how many apps are in step on it and how many are not (apps nobody else runs yet count as neither), how many problems it has, how old its Holochain readings are, and how long since it booted. Click a name to open that machine's page.",
      "datasource": {
        "type": "prometheus",
        "uid": "holochain-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "holochain-prometheus"
          },
          "expr": "min by (node) (holochain:node_state)",
          "format": "table",
          "instant": true,
          "range": false
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "holochain-prometheus"
          },
          "expr": "count by (node) (holochain:app_state:named == 5) or 0 * group by (node) (up{job=\"holochain-nodes\"})",
          "format": "table",
          "instant": true,
          "range": false
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "holochain-prometheus"
          },
          "expr": "count by (node) (holochain:app_state:named != 5 and holochain:app_state:named != 3) or 0 * group by (node) (up{job=\"holochain-nodes\"})",
          "format": "table",
          "instant": true,
          "range": false
        },
        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "holochain-prometheus"
          },
          "expr": "count by (node) (holochain:node_problem) or 0 * group by (node) (up{job=\"holochain-nodes\"})",
          "format": "table",
          "instant": true,
          "range": false
        },
        {
          "refId": "E",
          "datasource": {
            "type": "prometheus",
            "uid": "holochain-prometheus"
          },
          "expr": "max by (node) (time() - holochain_conductor_metrics_scrape_timestamp_seconds)",
          "format": "table",
          "instant": true,
          "range": false
        },
        {
          "refId": "F",
          "datasource": {
            "type": "prometheus",
            "uid": "holochain-prometheus"
          },
          "expr": "max by (node) (time() - node_boot_time_seconds)",
          "format": "table",
          "instant": true,
          "range": false
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": [
                "node",
                "Value #A",
                "Value #B",
                "Value #C",
                "Value #D",
                "Value #E",
                "Value #F"
              ]
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {},
            "indexByName": {
              "node": 0,
              "Value #A": 1,
              "Value #B": 2,
              "Value #C": 3,
              "Value #D": 4,
              "Value #E": 5,
              "Value #F": 6
            },
            "renameByName": {
              "node": "Node",
              "Value #A": "Status",
              "Value #B": "In step",
              "Value #C": "Not in step",
              "Value #D": "Problems",
              "Value #E": "Oldest reading",
              "Value #F": "Up for"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Node"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open this machine",
                    "url": "/d/holochain-node/holochain-node?var-node=${__value.raw}&${__url_time_range}"
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Status"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "Unreachable",
                        "color": "red",
                        "index": 0
                      },
                      "1": {
                        "text": "Holochain not answering",
                        "color": "red",
                        "index": 1
                      },
                      "2": {
                        "text": "No fresh readings",
                        "color": "orange",
                        "index": 2
                      },
                      "3": {
                        "text": "A service is down",
                        "color": "red",
                        "index": 3
                      },
                      "4": {
                        "text": "Running",
                        "color": "green",
                        "index": 4
                      },
                      "5": {
                        "text": "No Holochain here",
                        "color": "#8e8e8e",
                        "index": 5
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "In step"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Not in step"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "#EAB839",
                      "value": 1
                    }
                  ]
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Problems"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "red",
                      "value": 1
                    }
                  ]
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Oldest reading"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "noValue",
                "value": "no Holochain"
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 90,
                      "fromOption": "staleAfterSeconds"
                    },
                    {
                      "color": "red",
                      "value": 300
                    }
                  ]
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Up for"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dtdurations"
              },
              {
                "id": "noValue",
                "value": "-"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        },
        "sortBy": [
          {
            "displayName": "Status",
            "desc": false
          }
        ]
      }
    },
    {
      "id": 8,
      "type": "table",
      "title": "What needs a human?",
      "description": "What is wrong, on which machine, in words: failed services, full disks, memory, heat, unreadable metrics files, and Holochain conductors that are silent or behind.",
      "datasource": {
        "type": "prometheus",
        "uid": "holochain-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "holochain-prometheus"
          },
          "expr": "holochain:node_problem",
          "format": "table",
          "instant": true,
          "range": false
        }
      ],
      "transformations": [
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": [
                "node",
                "problem"
              ]
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {},
            "indexByName": {
              "node": 0,
              "problem": 1
            },
            "renameByName": {
              "node": "Node",
              "problem": "Problem"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "color-text"
            }
          },
          "color": {
            "mode": "fixed",
            "fixedColor": "red"
          },
          "noValue": "Nothing needs attention"
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      }
    },
    {
      "id": 9,
      "type": "table",
      "title": "Which watched services are down?",
      "description": "Every service that is not running, on every machine, by its name: what the modules enabled on each machine install and the services beside them, as the machine lists them itself (services.holochain-services.units), plus the units services.holochain-grafana.overviewUnits adds. Not answering means the service runs but does not answer its health check or, for a conductor, its admin interface. A service that is not listed here is running.",
      "datasource": {
        "type": "prometheus",
        "uid": "holochain-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "holochain-prometheus"
          },
          "expr": "holochain:service_state < 6",
          "format": "table",
          "instant": true,
          "range": false
        }
      ],
      "transformations": [
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": [
                "node",
                "service",
                "Value"
              ]
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {},
            "indexByName": {
              "node": 0,
              "service": 1,
              "Value": 2
            },
            "renameByName": {
              "node": "Node",
              "service": "Service",
              "Value": "State"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          },
          "noValue": "All watched services are running"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "State"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "Failed",
                        "color": "red",
                        "index": 0
                      },
                      "1": {
                        "text": "Stopped",
                        "color": "red",
                        "index": 1
                      },
                      "2": {
                        "text": "Not answering",
                        "color": "red",
                        "index": 2
                      },
                      "3": {
                        "text": "No fresh readings",
                        "color": "orange",
                        "index": 3
                      },
                      "4": {
                        "text": "Starting",
                        "color": "#EAB839",
                        "index": 4
                      },
                      "5": {
                        "text": "Stopping",
                        "color": "#EAB839",
                        "index": 5
                      },
                      "6": {
                        "text": "Running",
                        "color": "green",
                        "index": 6
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        },
