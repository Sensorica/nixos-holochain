      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {"show": false, "reducer": ["sum"], "fields": ""},
        "sortBy": [{"displayName": "Instance", "desc": false}]
      }
    },
    {
      "id": 3,
      "type": "table",
      "title": "Services",
      "description": "State of each systemd unit matched by the Units variable, one row per node and one column per unit, from node_exporter's systemd collector (node_systemd_unit_state). There is a column for every unit at least one selected node has; a node that does not have it shows absent in that column. A unit no selected node has gets no column. A node Prometheus cannot scrape has no unit states to show, so a node unreachable column appears, red on that node's row. The one-shot metrics service sits idle between runs, so its timer is what is listed.",
      "gridPos": {"h": 9, "w": 24, "x": 0, "y": 9},
      "datasource": {"type": "prometheus", "uid": "holochain-prometheus"},
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": "holochain-prometheus"},
          "expr": "max by (instance, name) (node_systemd_unit_state{instance=~\"$instance\", name=~`${units:raw}`, state=\"active\"} or 2 * node_systemd_unit_state{instance=~\"$instance\", name=~`${units:raw}`, state=~\"activating|deactivating\"} or 3 * node_systemd_unit_state{instance=~\"$instance\", name=~`${units:raw}`, state=\"failed\"} or label_replace(4 + 0 * (up{job=\"holochain-nodes\", instance=~\"$instance\"} == 0), \"name\", \"node unreachable\", \"instance\", \".*\"))",
          "format": "table",
          "instant": true,
          "range": false
        }
      ],
      "transformations": [
        {
          "id": "groupingToMatrix",
          "options": {"columnField": "name", "rowField": "instance", "valueField": "Value", "emptyValue": "null"}
        },
        {"id": "organize", "options": {"renameByName": {"instance\\name": "Instance"}}},
        {"id": "sortBy", "options": {"sort": [{"field": "Instance", "desc": false}]}}
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "center",
            "minWidth": 60,
            "cellOptions": {"type": "color-background", "mode": "basic"},
            "wrapHeaderText": true
          },
          "thresholds": {"mode": "absolute", "steps": [{"color": "transparent", "value": null}]},
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {"text": "inactive", "color": "orange", "index": 0},
                "1": {"text": "active", "color": "green", "index": 1},
                "2": {"text": "starting or stopping", "color": "yellow", "index": 2},
                "3": {"text": "failed", "color": "red", "index": 3},
                "4": {"text": "unreachable", "color": "red", "index": 4}
              }
            },
            {
              "type": "special",
              "options": {"match": "null", "result": {"text": "absent", "color": "transparent", "index": 5}}
            }
          ]
        },
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "Instance"},
            "properties": [
              {"id": "custom.cellOptions", "value": {"type": "auto"}},
              {"id": "custom.align", "value": "left"},
              {"id": "mappings", "value": []},
              {"id": "custom.width", "value": 260}
            ]
          }
        ]
      },
      "options": {"showHeader": true, "cellHeight": "sm", "footer": {"show": false, "reducer": ["sum"], "fields": ""}}
    },
    {
      "id": 4,
      "type": "row",
      "title": "Holochain",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 18},
      "collapsed": false,
      "panels": []
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Conductors up",
      "description": "holochain_conductor_up per node, written by the holochain-conductor-metrics timer from dump-network-stats, read the same way as the Conductor column of Fleet status: down means the node is reporting but its conductor did not answer; stale means the timer has not written for over 120 s; textfile error means node_exporter rejected the textfile; unknown means the node itself is not answering. This is the value now, not the last one seen.",
      "gridPos": {"h": 6, "w": 6, "x": 0, "y": 19},
      "datasource": {"type": "prometheus", "uid": "holochain-prometheus"},
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": "holochain-prometheus"},
          "expr": "(max by (instance) (holochain_conductor_up{instance=~\"$instance\"}) + on (instance) (2 * (max by (instance) (time() - holochain_conductor_metrics_scrape_timestamp_seconds{instance=~\"$instance\"}) > bool 120))) or on (instance) (4 * (max by (instance) (node_textfile_scrape_error{instance=~\"$instance\"}) > 0)) or on (instance) (5 + 0 * max by (instance) (up{job=\"holochain-nodes\", instance=~\"$instance\"} == 0))",
          "legendFormat": "{{instance}}",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "text": {"titleSize": 14, "valueSize": 16},
        "orientation": "horizontal",
        "wideLayout": true,
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {"text": "down", "color": "red", "index": 0},
                "1": {"text": "up", "color": "green", "index": 1},
                "2": {"text": "stale, was down", "color": "orange", "index": 2},
                "3": {"text": "stale, was up", "color": "orange", "index": 3},
                "4": {"text": "textfile error", "color": "red", "index": 4},
                "5": {"text": "unknown", "color": "text", "index": 5}
              }
            }
          ],
          "thresholds": {"mode": "absolute", "steps": [{"color": "text", "value": null}]}
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Conductor peers",
      "description": "holochain_conductor_peer_urls is how many addresses this conductor can be reached at, which is non-zero as soon as it has a transport. The two connection counts stay at zero until it joins a DHT, which means until a hApp is installed.",
      "gridPos": {"h": 6, "w": 9, "x": 6, "y": 19},
      "datasource": {"type": "prometheus", "uid": "holochain-prometheus"},
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": "holochain-prometheus"},
          "expr": "holochain_conductor_peer_urls{instance=~\"$instance\"}",
          "legendFormat": "{{instance}} peer urls"
        },
        {
          "refId": "B",
          "datasource": {"type": "prometheus", "uid": "holochain-prometheus"},
          "expr": "holochain_conductor_peer_connections{instance=~\"$instance\"}",
          "legendFormat": "{{instance}} connections"
        },
        {
          "refId": "C",
          "datasource": {"type": "prometheus", "uid": "holochain-prometheus"},
          "expr": "holochain_conductor_direct_peer_connections{instance=~\"$instance\"}",
          "legendFormat": "{{instance}} direct"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "unit": "short",
          "custom": {"drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "showPoints": "auto"}
        },
        "overrides": []
      },
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "multi", "sort": "desc"}
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Conductor network throughput",
      "description": "Rate of holochain_conductor_network_sent_bytes_total and _received_bytes_total. The metrics timer keeps these as running totals across runs, so a peer disconnecting does not pull them down; the bytes a connection moves between the timer's last look and its closing are not counted.",
      "gridPos": {"h": 6, "w": 9, "x": 15, "y": 19},
      "datasource": {"type": "prometheus", "uid": "holochain-prometheus"},
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": "holochain-prometheus"},
          "expr": "rate(holochain_conductor_network_sent_bytes_total{instance=~\"$instance\"}[2m])",
          "legendFormat": "{{instance}} sent"
        },
        {
          "refId": "B",
          "datasource": {"type": "prometheus", "uid": "holochain-prometheus"},
          "expr": "rate(holochain_conductor_network_received_bytes_total{instance=~\"$instance\"}[2m])",
          "legendFormat": "{{instance}} received"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "unit": "Bps",
          "custom": {"drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "showPoints": "auto"}
        },
        "overrides": []
      },
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "multi", "sort": "desc"}
      }
    },
    {
      "id": 8,
      "type": "bargauge",
      "title": "Conductor metrics age",
      "description": "Seconds since the holochain-conductor-metrics timer last wrote its textfile (time() minus holochain_conductor_metrics_scrape_timestamp_seconds), as of now. It stays under conductorMetrics.interval plus the scrape interval while the timer runs; past two minutes every holochain_* panel is showing old numbers. The 120 s and 300 s thresholds assume the default 30 s interval; raise them if the interval is above about 90 s. A down conductor does not raise it: the file is still written, with holochain_conductor_up 0. A node Prometheus cannot scrape drops out of this panel rather than showing its last age.",
      "gridPos": {"h": 7, "w": 6, "x": 0, "y": 25},
      "datasource": {"type": "prometheus", "uid": "holochain-prometheus"},
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": "holochain-prometheus"},
          "expr": "time() - holochain_conductor_metrics_scrape_timestamp_seconds{instance=~\"$instance\"}",
          "legendFormat": "{{instance}}",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "valueMode": "color",
        "namePlacement": "top",
        "showUnfilled": true,
        "sizing": "auto",
        "text": {"titleSize": 12, "valueSize": 14},
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 120}, {"color": "red", "value": 300}]
          },
          "min": 0,
          "max": 300
        },
        "overrides": []
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Conductor messages",
      "description": "Rate of holochain_conductor_network_sent_messages_total and _received_messages_total, running totals the metrics timer keeps across runs, like the throughput panel's bytes.",
      "gridPos": {"h": 7, "w": 9, "x": 6, "y": 25},
      "datasource": {"type": "prometheus", "uid": "holochain-prometheus"},
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": "holochain-prometheus"},
          "expr": "rate(holochain_conductor_network_sent_messages_total{instance=~\"$instance\"}[2m])",
          "legendFormat": "{{instance}} sent"
        },
        {
          "refId": "B",
          "datasource": {"type": "prometheus", "uid": "holochain-prometheus"},
          "expr": "rate(holochain_conductor_network_received_messages_total{instance=~\"$instance\"}[2m])",
          "legendFormat": "{{instance}} received"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "unit": "suffix: msg/s",
          "custom": {"drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "showPoints": "auto"}
        },
        "overrides": []
      },
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "multi", "sort": "desc"}
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Blocked messages",
      "description": "Messages the conductor blocked over the last five minutes, in either direction and summed over every block reason (increase of holochain_conductor_blocked_messages_total). Anything above zero means this node refused to receive from, or to send to, a peer it does not accept.",
      "gridPos": {"h": 7, "w": 9, "x": 15, "y": 25},
      "datasource": {"type": "prometheus", "uid": "holochain-prometheus"},
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": "holochain-prometheus"},
          "expr": "increase(holochain_conductor_blocked_messages_total{instance=~\"$instance\"}[5m])",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "unit": "short",
          "decimals": 0,
          "custom": {"drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "showPoints": "auto"}
        },
        "overrides": []
      },
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "multi", "sort": "desc"}
      }
    },
    {
      "id": 11,
      "type": "row",
      "title": "Host health",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 32},
      "collapsed": false,
      "panels": []
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "CPU busy",
      "description": "Percentage of CPU time not spent idle, from node_exporter's cpu collector.",
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 33},
      "datasource": {"type": "prometheus", "uid": "holochain-prometheus"},
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": "holochain-prometheus"},
          "expr": "100 - (avg by (instance) (rate(node_cpu_seconds_total{instance=~\"$instance\", mode=\"idle\"}[2m])) * 100)",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 100,
          "unit": "percent",
          "custom": {"drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "showPoints": "auto"}
        },
        "overrides": []
      },
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "multi", "sort": "desc"}
      }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Memory used",
      "description": "Share of RAM that is not available, from node_exporter's meminfo collector.",
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 33},
      "datasource": {"type": "prometheus", "uid": "holochain-prometheus"},
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": "holochain-prometheus"},
          "expr": "100 * (1 - node_memory_MemAvailable_bytes{instance=~\"$instance\"} / node_memory_MemTotal_bytes{instance=~\"$instance\"})",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 100,
          "unit": "percent",
          "custom": {"drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "showPoints": "auto"}
        },
        "overrides": []
      },
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "multi", "sort": "desc"}
      }
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Load average",
      "description": "Five-minute load average (node_load5) divided by the node's CPU count, one line per node. Above the dashed line at 1, work is queueing for the processor. node_load1 and node_load15 are in Prometheus for a closer look.",
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 33},
      "datasource": {"type": "prometheus", "uid": "holochain-prometheus"},
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": "holochain-prometheus"},
          "expr": "max by (instance) (node_load5{instance=~\"$instance\"}) / on (instance) count by (instance) (node_cpu_seconds_total{instance=~\"$instance\", mode=\"idle\"})",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "unit": "short",
          "decimals": 2,
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]},
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "auto",
            "thresholdsStyle": {"mode": "dashed"}
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "multi", "sort": "desc"}
      }
    },
    {
      "id": 15,
      "type": "bargauge",
      "title": "Disk space used",
      "description": "Share of each mounted filesystem that is used, from node_exporter's filesystem collector. Memory-backed and image filesystems (tmpfs, ramfs, overlay, squashfs) are left out, and so is /nix/store, which NixOS bind-mounts from the filesystem that holds /nix.",
      "gridPos": {"h": 10, "w": 8, "x": 0, "y": 41},
      "datasource": {"type": "prometheus", "uid": "holochain-prometheus"},
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": "holochain-prometheus"},
          "expr": "100 * (1 - node_filesystem_avail_bytes{instance=~\"$instance\", fstype!~\"tmpfs|ramfs|overlay|squashfs\", mountpoint!=\"/nix/store\"} / node_filesystem_size_bytes{instance=~\"$instance\", fstype!~\"tmpfs|ramfs|overlay|squashfs\", mountpoint!=\"/nix/store\"})",
          "legendFormat": "{{instance}} {{mountpoint}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 100,
          "unit": "percent",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 80}, {"color": "red", "value": 90}]
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "valueMode": "color",
        "namePlacement": "top",
        "sizing": "auto",
        "text": {"titleSize": 12, "valueSize": 14},
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}
      }
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "Disk IO",
      "description": "Bytes per second read (above the axis) and written (below it), summed over each node's disks, from node_exporter's diskstats collector, which already leaves out partitions and loop devices; optical drives are left out too. Per-disk series are in Prometheus as node_disk_read_bytes_total and node_disk_written_bytes_total.",
      "gridPos": {"h": 10, "w": 8, "x": 8, "y": 41},
      "datasource": {"type": "prometheus", "uid": "holochain-prometheus"},
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": "holochain-prometheus"},
          "expr": "sum by (instance) (rate(node_disk_read_bytes_total{instance=~\"$instance\", device!~\"sr[0-9]+\"}[2m]))",
          "legendFormat": "{{instance}} read"
        },
        {
          "refId": "B",
          "datasource": {"type": "prometheus", "uid": "holochain-prometheus"},
          "expr": "sum by (instance) (rate(node_disk_written_bytes_total{instance=~\"$instance\", device!~\"sr[0-9]+\"}[2m]))",
          "legendFormat": "{{instance}} written"
        }
      ],
      "fieldConfig": {
        "defaults": {"unit": "Bps", "custom": {"drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "showPoints": "auto"}},
        "overrides": [
          {
            "matcher": {"id": "byFrameRefID", "options": "B"},
            "properties": [{"id": "custom.transform", "value": "negative-Y"}]
          }
        ]
      },
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "multi", "sort": "desc"}
      }
    },
    {
      "id": 17,
      "type": "timeseries",
      "title": "Temperatures",
      "description": "The hottest temperature sensor on each node (the maximum of node_hwmon_temp_celsius over every chip and sensor node_exporter's hwmon collector finds). Dashed lines at 75 and 85 C. A virtual machine usually exposes no sensors, and this panel then says No data. Per-sensor series are in Prometheus; on an Intel machine the coretemp chip's temp1 is the package and the others are cores.",
      "gridPos": {"h": 10, "w": 8, "x": 16, "y": 41},
      "datasource": {"type": "prometheus", "uid": "holochain-prometheus"},
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": "holochain-prometheus"},
          "expr": "max by (instance) (node_hwmon_temp_celsius{instance=~\"$instance\"})",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "auto",
            "thresholdsStyle": {"mode": "dashed"}
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 75}, {"color": "red", "value": 85}]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "multi", "sort": "desc"}
      }
    },
    {
      "id": 18,
      "type": "timeseries",
      "title": "Host network throughput",
      "description": "Bytes per second in and out of every interface except loopback, from node_exporter's netdev collector.",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 51},
      "datasource": {"type": "prometheus", "uid": "holochain-prometheus"},
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": "holochain-prometheus"},
          "expr": "sum by (instance) (rate(node_network_receive_bytes_total{instance=~\"$instance\", device!=\"lo\"}[2m]))",
          "legendFormat": "{{instance}} in"
        },
        {
          "refId": "B",
          "datasource": {"type": "prometheus", "uid": "holochain-prometheus"},
          "expr": "sum by (instance) (rate(node_network_transmit_bytes_total{instance=~\"$instance\", device!=\"lo\"}[2m]))",
          "legendFormat": "{{instance}} out"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "unit": "Bps",
          "custom": {"drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "showPoints": "auto"}
        },
        "overrides": []
      },
      "options": {
        "legend": {"displayMode": "table", "placement": "right", "showLegend": true, "calcs": ["lastNotNull"]},
        "tooltip": {"mode": "multi", "sort": "desc"}
      }
    },
    {
      "id": 19,
      "type": "timeseries",
      "title": "Pressure",
      "description": "Share of time some task was stalled waiting for CPU, memory or IO, from the kernel's pressure stall information (node_exporter's pressure collector). Sustained memory or IO pressure is the early sign of a machine that is too small for what it runs.",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 51},
      "datasource": {"type": "prometheus", "uid": "holochain-prometheus"},
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": "holochain-prometheus"},
          "expr": "100 * rate(node_pressure_cpu_waiting_seconds_total{instance=~\"$instance\"}[2m])",
          "legendFormat": "{{instance}} cpu"
        },
        {
          "refId": "B",
          "datasource": {"type": "prometheus", "uid": "holochain-prometheus"},
          "expr": "100 * rate(node_pressure_memory_waiting_seconds_total{instance=~\"$instance\"}[2m])",
          "legendFormat": "{{instance}} memory"
        },
        {
          "refId": "C",
          "datasource": {"type": "prometheus", "uid": "holochain-prometheus"},
          "expr": "100 * rate(node_pressure_io_waiting_seconds_total{instance=~\"$instance\"}[2m])",
          "legendFormat": "{{instance}} io"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "unit": "percent",
          "custom": {"drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "showPoints": "auto"}
        },
        "overrides": []
      },
      "options": {
        "legend": {"displayMode": "table", "placement": "right", "showLegend": true, "calcs": ["lastNotNull"]},
        "tooltip": {"mode": "multi", "sort": "desc"}
      }
    }
  ]
}
