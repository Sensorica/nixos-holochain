{
  "uid": "holochain-fleet",
  "title": "Which Holochain node needs attention?",
  "description": "For whoever runs the fleet: is any machine unreachable, any conductor silent or stale, any app part cut off or behind, any machine short of something, and which one.",
  "tags": [
    "holochain",
    "nixos-holochain"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "type": "link",
      "title": "Room view",
      "url": "/d/holochain-now/holochain-now",
      "asDropdown": false,
      "includeVars": false,
      "keepTime": true,
      "targetBlank": false,
      "icon": "dashboard",
      "tags": [],
      "tooltip": ""
    },
    {
      "type": "dashboards",
      "tags": [
        "holochain"
      ],
      "asDropdown": true,
      "title": "Holochain dashboards",
      "includeVars": false,
      "keepTime": true,
      "targetBlank": false,
      "icon": "external link",
      "tooltip": "",
      "url": ""
    }
  ],
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Unreachable",
      "description": "How many machines Prometheus could not reach.",
      "datasource": {
        "type": "prometheus",
        "uid": "holochain-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "holochain-prometheus"
          },
          "expr": "count(holochain:node_state == 0) or vector(0)",
          "legendFormat": "Unreachable",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "decimals": 0,
          "unit": "none"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "value",
        "wideLayout": true,
        "showPercentChange": false
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Holochain silent",
