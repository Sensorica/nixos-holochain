                "value": {
                  "mode": "absolute",
                  "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 80}, {"color": "red", "value": 90}]
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "special",
                    "options": {"match": "null", "result": {"text": "", "color": "transparent", "index": 9}}
                  }
                ]
              }
            ]
          },
          {
            "matcher": {"id": "byName", "options": "Memory"},
            "properties": [
              {"id": "custom.cellOptions", "value": {"type": "color-background", "mode": "basic"}},
              {"id": "unit", "value": "percent"},
              {"id": "decimals", "value": 0},
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 85}, {"color": "red", "value": 95}]
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "special",
                    "options": {"match": "null", "result": {"text": "", "color": "transparent", "index": 9}}
                  }
                ]
              }
