  "templating": {
    "list": [
      {
        "name": "node",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "holochain-prometheus"
        },
        "definition": "label_values(up{job=\"holochain-nodes\"}, node)",
        "query": {
          "query": "label_values(up{job=\"holochain-nodes\"}, node)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 2,
        "regex": "",
        "sort": 1,
        "multi": false,
        "includeAll": false,
        "hide": 0,
        "current": {},
        "options": [],
        "label": "Node"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "State",
      "description": "The state of this machine as a whole, in the same words as the fleet page and the room screen: Unreachable when Prometheus cannot reach it, Holochain not answering when a conductor does not answer, A service is down when a service below has failed, stopped or does not answer, No fresh readings when a conductor's or a service's readings are old, Running when all is well, and No Holochain here for a machine without a conductor.",
      "datasource": {
        "type": "prometheus",
        "uid": "holochain-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 5,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "holochain-prometheus"
          },
          "expr": "holochain:node_state{node=\"$node\"}",
          "instant": true,
          "range": false,
          "legendFormat": "{{node}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#8e8e8e",
                "value": null
              }
            ]
          },
          "noValue": "Not watched: this machine is not among the monitor's scrape targets",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Unreachable",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "Holochain not answering",
                  "color": "red",
                  "index": 1
                },
                "2": {
                  "text": "A service is down",
                  "color": "red",
                  "index": 2
                },
                "3": {
                  "text": "No fresh readings",
                  "color": "orange",
                  "index": 3
                },
                "4": {
                  "text": "Running",
                  "color": "green",
                  "index": 4
                },
                "5": {
                  "text": "No Holochain here",
                  "color": "#8e8e8e",
                  "index": 5
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "value",
        "wideLayout": true,
        "showPercentChange": false
      }
    },
