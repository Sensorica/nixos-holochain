    {
      "id": 6,
      "type": "gauge",
      "title": "CPU busy",
      "description": "The share of the processor's time spent working, over the last two minutes, all cores together. Amber from 75%, red from 90%.",
      "datasource": {
        "type": "prometheus",
        "uid": "holochain-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 8,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "holochain-prometheus"
          },
          "expr": "1 - avg(rate(node_cpu_seconds_total{node=\"$node\", mode=\"idle\"}[2m]))",
          "instant": true,
          "range": false,
          "legendFormat": "CPU busy"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "#EAB839",
                "value": 0.75
              },
              {
                "color": "red",
                "value": 0.9
              }
            ]
          },
          "noValue": "No readings from this machine"
        },
        "overrides": []
      },
      "options": {
